<Project>
  <!--
    Welle A 0.97.0 (Weisung P12-312 Punkt 3, W2): Lern-Dateien je Fachrichtung beim Bauen aufteilen. Quelle bleibt allein
    inhalte_csharp/lernen/*.json; die Teile entstehen bei jedem Bau neu (obj/.../lernen_teile, nie eingecheckt) und kommen als
    inhalte_csharp/lernen_teile/<datei> ins Programm. Der Teiler steht in LernenTeile.cs (dieselbe Datei pruefen die Tests).
  -->
  <UsingTask TaskName="Lernplattform.Bau.LernenTeileBauen" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Quelle ParameterType="System.String" Required="true" />
      <Ziel ParameterType="System.String" Required="true" />
      <NurImPaket ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)LernenTeile.cs" />
    </Task>
  </UsingTask>

  <PropertyGroup>
    <LernenTeileQuelle>$(MSBuildThisFileDirectory)../../inhalte_csharp/lernen/</LernenTeileQuelle>
    <!-- Welle A 1.5.0 (Weisung P12-358, Sammelliste 386, Nico 1b): AE, DPA und DV nur als Fachrichtungs-Paket; ihre Eintraege
         werden beim Bauen zu Platzhaltern (die Quelle im Repo bleibt unveraendert und einzige Quelle der Pakete) -->
    <LernenNurImPaket>ae;dpa;dv</LernenNurImPaket>
  </PropertyGroup>

  <!-- IntermediateOutputPath steht erst nach dem Projekt fest: Ziel darum in einem eigenen Ziel vorab setzen -->
  <Target Name="LernenTeileZielSetzen">
    <PropertyGroup>
      <LernenTeileZiel>$(MSBuildProjectDirectory)/$(IntermediateOutputPath)lernen_teile/</LernenTeileZiel>
    </PropertyGroup>
  </Target>

  <Target Name="LernenTeileErzeugen" BeforeTargets="BeforeBuild" DependsOnTargets="LernenTeileZielSetzen"
          Inputs="@(LernenTeileQuellen);$(MSBuildThisFileDirectory)LernenTeile.cs"
          Outputs="$(LernenTeileZiel)teile.json;$(LernenTeileZiel)ganz/quizfragen.json">
    <Lernplattform.Bau.LernenTeileBauen Quelle="$(LernenTeileQuelle)" Ziel="$(LernenTeileZiel)" NurImPaket="$(LernenNurImPaket)" />
  </Target>

  <!-- WithCulture="false": sonst haelt MSBuild ".si" in "quizfragen.si.json" fuer die Sprache Singhalesisch und legt die
       SI-Teile in eine Satelliten-Datei si/Lernplattform.App.resources.dll (das Programm faende sie nicht) -->
  <Target Name="LernenTeileEinbetten" AfterTargets="LernenTeileErzeugen" BeforeTargets="BeforeBuild" DependsOnTargets="LernenTeileZielSetzen">
    <ItemGroup>
      <LernenTeileDatei Include="$(LernenTeileZiel)*.json" />
      <EmbeddedResource Include="@(LernenTeileDatei)" LogicalName="inhalte_csharp/lernen_teile/%(Filename)%(Extension)" WithCulture="false" Visible="false" />
      <FileWrites Include="@(LernenTeileDatei)" />
      <!-- Welle A 1.5.0: die geschnittenen ganzen Dateien ersetzen die Quelle im Programm (Name wie bisher inhalte_csharp/lernen/...) -->
      <LernenGanzDatei Include="$(LernenTeileZiel)ganz/*.json" />
      <EmbeddedResource Include="@(LernenGanzDatei)" LogicalName="inhalte_csharp/lernen/%(Filename)%(Extension)" WithCulture="false" Visible="false" />
      <FileWrites Include="@(LernenGanzDatei)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <LernenTeileQuellen Include="$(MSBuildThisFileDirectory)../../inhalte_csharp/lernen/*.json" />
  </ItemGroup>
</Project>
