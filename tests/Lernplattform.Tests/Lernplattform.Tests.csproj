<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Lernplattform.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <!-- A 0.53.2 (Sammelliste 256): Update-Quelle am PC mit Testserver (Velopack) -->
    <PackageReference Include="Velopack" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Lernplattform.Core\Lernplattform.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- A 0.53.2 (Sammelliste 256): stoerungsfeste Update-Quelle am PC und die alte Quelle fuer die Gegenprobe -->
    <Compile Include="..\..\src\Lernplattform.Desktop\LinienQuelle.cs" Link="LinienQuelle.cs" />
    <Compile Include="..\..\src\Lernplattform.Desktop\StoerungsfesteQuelle.cs" Link="StoerungsfesteQuelle.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Vergleichswerte und Lerninhalte neben die Testdateien kopieren -->
    <None Include="..\Vergleich\**\*" LinkBase="Vergleich" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\inhalte\**\*" LinkBase="inhalte" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
