<Project Sdk="Microsoft.NET.Sdk">
  <!-- Weisung P12-179 (Engine-Projekt): Grundlagen fuer Spiel-Kern und eigene Engine: Nachbau der Python-Werte und
       -Rechnungen (Py*, PythonJson, PythonRunden, PythonPow, PythonZeichen, PythonKlein), Zeit des Spiels (Jahreszeit,
       Festzeit), Lesen der Spielinhalte (SpielDaten, SpielInhalt), Wege im Grundriss, Modelle der Stadt, Aussehen der Figur
       und die Sicht auf den Spielstand (ISpielSicht). Die Grundlagen kennen weder Lernteil noch Spiel-Kern noch Engine
       (Test EngineGrenzenTests).
       Die Dateien bleiben an ihrem Ort in Lernplattform.Core (verlinkt, E1): mehrere sind Stoppgrenzen (Python*.cs,
       SpielInhalt.cs) oder Sollwerte (Tabellen in SOLLWERTE.sha256), deren Pfad gleich bleiben muss; Namensraeume
       unveraendert (Lernplattform.Core.*), darum keine using-Aenderung. Lernplattform.Core nimmt sie aus dem eigenen Bau. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lernplattform.Core</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <Import Project="..\Lernplattform.Core\Grundlagen.props" />
  <ItemGroup>
    <Compile Include="@(GrundlagenDatei)" Link="%(GrundlagenDatei.RecursiveDir)%(GrundlagenDatei.Filename)%(GrundlagenDatei.Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lernplattform.Core" />
    <InternalsVisibleTo Include="Lernplattform.Engine" />
    <InternalsVisibleTo Include="Lernplattform.Tests" />
    <InternalsVisibleTo Include="Stadtbau.Tests" />
  </ItemGroup>
</Project>
