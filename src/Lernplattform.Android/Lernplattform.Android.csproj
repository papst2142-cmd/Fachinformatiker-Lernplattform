<Project Sdk="Microsoft.NET.Sdk">
  <!-- Start fuer Android. Nur arm64-v8a (Projektregel). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <RootNamespace>Lernplattform.Android</RootNamespace>
    <!-- Kennung endgueltig (Entscheidung Nico 19.10.2026), gilt fuer A, B und 1.0 -->
    <ApplicationId>io.github.papst2142cmd.lernplattform</ApplicationId>
    <ApplicationTitle>Fachinformatiker Lernplattform</ApplicationTitle>
    <!-- Versionscode und Anzeige aus Directory.Build.props (Stufe, Version); A 0.1.0 = 1000100, "A 0.1.0" -->
    <ApplicationVersion>$(AndroidVersionscode)</ApplicationVersion>
    <ApplicationDisplayVersion>$(AndroidAnzeige)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>

  <!-- Phase 7 W1 (Weisung P7-2, Frage 4a): Probe-APK der 3D-Stichprobe, nur mit -p:Probe=true aus der CI.
       Befristete Ausnahme NUR fuer die Probe: eigene Kennung und eigener Name, damit sie neben der echten
       App liegt und deren Lernstand nie beruehrt. Die echte Kennung oben bleibt unveraendert. -->
  <PropertyGroup Condition="'$(Probe)' == 'true'">
    <ApplicationId>io.github.papst2142cmd.lernplattform.probe</ApplicationId>
    <ApplicationTitle>Lernplattform Probe</ApplicationTitle>
    <DefineConstants>$(DefineConstants);PROBE</DefineConstants>
    <!-- eigenes Manifest nur fuer den App-Namen (android:label), das normale Manifest bleibt unberuehrt -->
    <AndroidManifest>Properties\AndroidManifest.Probe.xml</AndroidManifest>
  </PropertyGroup>

  <!-- A 0.39.0 (Weisung P11-40 Frage 5a): Emulator-Probe des Updates im Programm, NUR in der CI (-p:UpdateProbe=true),
       nie ausgeliefert. x86_64 fuer den Emulator, Testserver und Fingerabdruck des Testschluessels aus dem Lauf;
       die App sucht beim Start ueber den Testserver und aktualisiert sich ohne Bedienung (UpdateProbe.cs). -->
  <PropertyGroup Condition="'$(UpdateProbe)' == 'true'">
    <DefineConstants>$(DefineConstants);UPDATEPROBE</DefineConstants>
    <RuntimeIdentifiers>android-x64</RuntimeIdentifiers>
    <AndroidManifest>Properties\AndroidManifest.UpdateProbe.xml</AndroidManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(UpdateProbe)' == 'true'">
    <AssemblyMetadata Include="UpdateProbeUrl" Value="$(UpdateProbeUrl)" />
    <AssemblyMetadata Include="UpdateProbeFingerabdruck" Value="$(UpdateProbeFingerabdruck)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernplattform.App\Lernplattform.App.csproj" />
  </ItemGroup>
</Project>
