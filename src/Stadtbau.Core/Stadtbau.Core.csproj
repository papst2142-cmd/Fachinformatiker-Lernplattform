<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 13 Welle 2 (Weisung P12-17): Logik des Stadtbau-Werkzeugs ohne Oberflaeche (Projekt, Verlauf, Sicherungen,
       Bearbeitung, Export, Senden). Format und Pruefung liegen in der eigenen Engine (Lernplattform.Engine, Weisung P12-179). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Stadtbau.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Stadtbau.Tests" />
    <InternalsVisibleTo Include="Stadtbau.App" />
  </ItemGroup>
  <!-- Phase 13 Welle 3b (Weisungen P12-19, P12-23 1a): voller CC0-Katalog (werkzeuge/stadtbau/wandle_katalog.py), nur im Werkzeug -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\inhalte_stadtbau\grafik\*" LogicalName="inhalte_stadtbau/grafik/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\..\inhalte_stadtbau\namen_de.json" LogicalName="inhalte_stadtbau/namen_de.json" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- Weisung P12-179: die eigene Engine (Szene, Format, Pruefung) und der Spiel-Kern (Stadt, Probestand) -->
    <ProjectReference Include="..\Lernplattform.Engine\Lernplattform.Engine.csproj" />
    <ProjectReference Include="..\Lernplattform.Core\Lernplattform.Core.csproj" />
  </ItemGroup>
</Project>
