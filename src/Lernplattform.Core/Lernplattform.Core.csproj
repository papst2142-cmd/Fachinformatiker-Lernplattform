<Project Sdk="Microsoft.NET.Sdk">
  <!-- Logik ohne Oberflaeche: Lernen, Rechner, Pruefung, Spiel-Kern, Daten, Design-Rechnung -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lernplattform.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Phase 8 W8: Toene (OGG) lesen, nur verwalteter Code -->
    <PackageReference Include="NVorbis" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lernplattform.Tests" />
    <InternalsVisibleTo Include="Stadtbau.Tests" />
  </ItemGroup>
  <!-- BEFRISTET bis 1.0 (Weisung P11-29): Schluessel fuer "Bericht senden" nur beim Bau aus der Umgebungsvariable
       FEHLERBERICHT_TOKEN (setzen nur release.yml und der Dispatch-Lauf "voll"), maskiert in obj/.../BerichtSchluessel.g.cs,
       nie im Repo, nie in einer Ausgabe. Ohne Variable: leere Liste ("nicht verfuegbar"). Maske wie BerichtSchluessel.Maske:
       kein Schutz, nur gegen Zufallsfunde. -->
  <UsingTask TaskName="BerichtSchluesselErzeugen" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Ziel ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var wert = (System.Environment.GetEnvironmentVariable("FEHLERBERICHT_TOKEN") ?? "").Trim();
        var roh = System.Text.Encoding.UTF8.GetBytes(wert);
        var text = new System.Text.StringBuilder();
        text.Append("// <auto-generated/> Beim Bau erzeugt (Lernplattform.Core.csproj, Ziel BerichtSchluessel). Nie einchecken.\n");
        text.Append("namespace Lernplattform.Core.Diagnose;\n\ninternal static partial class BerichtSchluessel\n{\n");
        text.Append("    private static readonly byte[] Daten = [");
        for (var i = 0; i < roh.Length; i++)
        {
            text.Append(i == 0 ? "" : ", ").Append(((byte)(roh[i] ^ (byte)((0xA7 ^ (i * 151 + 29)) & 0xFF))).ToString(System.Globalization.CultureInfo.InvariantCulture));
        }
        text.Append("];\n}\n");
        var neu = text.ToString();
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(Ziel));
        if (!System.IO.File.Exists(Ziel) || System.IO.File.ReadAllText(Ziel) != neu)
        {
            System.IO.File.WriteAllText(Ziel, neu);
        }
        Log.LogMessage(MessageImportance.High, "BerichtSchluessel: " + (roh.Length > 0 ? "eingebaut" : "ohne Schluessel"));
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="BerichtSchluessel" BeforeTargets="BeforeBuild;CoreCompile">
    <BerichtSchluesselErzeugen Ziel="$(IntermediateOutputPath)BerichtSchluessel.g.cs" />
    <ItemGroup>
      <Compile Remove="$(IntermediateOutputPath)BerichtSchluessel.g.cs" />
      <Compile Include="$(IntermediateOutputPath)BerichtSchluessel.g.cs" />
    </ItemGroup>
  </Target>
</Project>
