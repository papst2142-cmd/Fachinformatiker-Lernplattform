<Project Sdk="Microsoft.NET.Sdk">
  <!-- Start fuer Windows, Linux und macOS -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Lernplattform</AssemblyName>
    <RootNamespace>Lernplattform.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Lernplattform.App\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Welle A 0.97.0 (Weisung P12-312 Punkt 4, W3, Nico 2c): die ausgelieferten Pakete (dotnet publish -r <rid>: win-x64,
       linux-x64, osx-arm64, osx-x64) werden vorab uebersetzt (ReadyToRun); der Start beginnt dann ohne Uebersetzen des
       Programms. Der Start-Test misst denselben Bau (ci.yml, werkzeuge/starttest/lauf.sh). Android nutzt eine andere
       Laufzeit (kein ReadyToRun). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- Am Mac (osx-arm64, osx-x64) bleibt die Engine ohne Vorab-Uebersetzung: Lauf 1103 mass dort mit vorab uebersetzter
       Engine „Stadt bauen Testkarte“ deutlich langsamer (Teil Bauen macos-15 1031 -> 1433/1808 ms, Intel 821 -> 1926 ms,
       Grenze 2000 ms), Windows und Linux wurden schneller (1208 -> 935, 1447 -> 1333 ms). Die Engine baut die Stadt in langen
       Schleifen, die einmal laufen; ohne Vorab-Uebersetzung optimiert die Laufzeit sie beim ersten Lauf voll. Das Laden der
       Inhalte liegt in Core und App und bleibt vorab uebersetzt. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <PublishReadyToRunExclude Include="Lernplattform.Engine.dll" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernplattform.App\Lernplattform.App.csproj" />
  </ItemGroup>
</Project>
