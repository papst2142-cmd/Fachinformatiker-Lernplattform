<Project Sdk="Microsoft.NET.Sdk">
  <!-- Phase 13 Welle 2 (Weisung P12-17): Start des Stadtbau-Werkzeugs am PC (Windows; Linux nur fuer Start-Test und Fotos) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Stadtbau</AssemblyName>
    <RootNamespace>Stadtbau.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Stadtbau.App\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Update-Quelle mit Filter nach Release-Linie (nur Tags vS...), dieselbe Datei wie in der Lernplattform -->
    <Compile Include="..\Lernplattform.Desktop\LinienQuelle.cs" Link="LinienQuelle.cs" />
    <!-- A 0.53.2 (Sammelliste 256): stoerungsfeste Update-Quelle, gemeinsam mit der Lernplattform -->
    <Compile Include="..\Lernplattform.Desktop\StoerungsfesteQuelle.cs" Link="StoerungsfesteQuelle.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stadtbau.App\Stadtbau.App.csproj" />
  </ItemGroup>
</Project>
