<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gemeinsame Avalonia-Oberflaeche fuer PC und Handy (eine Codebasis) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lernplattform</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 1: Lerninhalte im Programm selbst (PC und Handy gleich), unveraendert aus inhalte/ -->
    <EmbeddedResource Include="..\..\inhalte\*.json" LogicalName="inhalte/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\..\inhalte\spiel\balancing.json" LogicalName="inhalte/spiel/balancing.json" Visible="false" />
    <!-- Fuer "Über das Programm": Lizenz und Hinweise zu Fremdbestandteilen -->
    <EmbeddedResource Include="..\..\LICENSE.txt;..\..\THIRD_PARTY_NOTICES.txt" LogicalName="texte/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernplattform.Core\Lernplattform.Core.csproj" />
  </ItemGroup>
</Project>
