<Project Sdk="Microsoft.NET.Sdk">
  <!-- Gemeinsame Avalonia-Oberflaeche fuer PC und Handy (eine Codebasis) -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Lernplattform</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Phase 7 W1: 3D-Flaeche uebergibt Puffer und Matrizen per Zeiger an OpenGL -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 1: Lerninhalte im Programm selbst (PC und Handy gleich), unveraendert aus inhalte/ -->
    <EmbeddedResource Include="..\..\inhalte\*.json" LogicalName="inhalte/%(Filename)%(Extension)" Visible="false" />
    <!-- Phase 7 W4: alle Spielinhalte (Spiel-Kern und 3D-Stadt), unveraendert aus inhalte/spiel -->
    <EmbeddedResource Include="..\..\inhalte\spiel\*.json" LogicalName="inhalte/spiel/%(Filename)%(Extension)" Visible="false" />
    <!-- Phase 7 W4 (Sammelliste 100): Inhalte nur der C#-Linie (Stadt-Kern), getrennt von inhalte/ (G1) -->
    <EmbeddedResource Include="..\..\inhalte_csharp\spiel\*.json" LogicalName="inhalte_csharp/spiel/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="..\..\inhalte_csharp\grafik\*.*" LogicalName="inhalte_csharp/grafik/%(Filename)%(Extension)" Visible="false" />
    <!-- Fuer "Über das Programm": Lizenz und Hinweise zu Fremdbestandteilen -->
    <EmbeddedResource Include="..\..\LICENSE.txt;..\..\THIRD_PARTY_NOTICES.txt" LogicalName="texte/%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lernplattform.Core\Lernplattform.Core.csproj" />
  </ItemGroup>
</Project>
