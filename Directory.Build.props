<Project>
  <!-- Gemeinsame Einstellungen aller Projekte. Version nur hier aendern. -->
  <PropertyGroup>
    <!-- Interne Zahlenversion; Anzeige "A 0.1.0" (A = Alphaphase), Tag vA0.1.0 -->
    <Version>0.1.0</Version>
    <Stufe>A</Stufe>
    <Product>Fachinformatiker Lernplattform</Product>
    <Company>Nico H</Company>
    <Authors>Nico H</Authors>
    <Copyright>Copyright (c) 2026 Nico H</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Paketversion fuer den Updater (SemVer): A 0.1.0 = 1.0.0-a.0.1.0, B 0.1.0 = 1.0.0-b.0.1.0,
         ab 1.0 ohne Stufe = Version. So gilt A < B < 1.0 von Anfang an (Entscheidung 5). -->
    <PaketVersion Condition="'$(Stufe)' != ''">1.0.0-$(Stufe.ToLowerInvariant()).$(Version)</PaketVersion>
    <PaketVersion Condition="'$(Stufe)' == ''">$(Version)</PaketVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="Stufe" Value="$(Stufe)" />
    <AssemblyMetadata Include="PaketVersion" Value="$(PaketVersion)" />
  </ItemGroup>
</Project>
