<Project>
  <!-- Alle Paketversionen fest an einer Stelle (zentrale Paketverwaltung). -->
  <!-- Neue Pakete nur mit Eintrag in THIRD_PARTY_NOTICES.txt und Lizenzpruefung. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia: alle Teile immer gleiche Version -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <!-- Daten -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <!-- Nur Tests, wird nicht ausgeliefert -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
